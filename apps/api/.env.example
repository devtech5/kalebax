# Copier en .env et adapter. Le .env n'est jamais committé.

# Base de données
DATABASE_URL="postgresql://kalebax:kalebax@localhost:5432/kalebax?schema=public"

# Clé de signature des jetons d'accès, Ed25519 au format PKCS#8 PEM.
# En développement, elle est générée au démarrage si absente ; en production,
# son absence doit empêcher l'application de démarrer.
JWT_PRIVATE_KEY=

# Durées. La session locale d'un agent est un paramètre d'organisation, pas
# une variable d'environnement : voir Organization.offlineGraceDays.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

PORT=3000
NODE_ENV=development
